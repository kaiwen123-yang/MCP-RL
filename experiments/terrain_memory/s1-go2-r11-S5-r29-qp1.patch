+    scale=std::max(scale,hc);
+  }
+  const double gradient_tol=relative_tol*scale;
+  std::vector<int> active(n),free;
+  std::vector<double> delta(n),gradient(n),direction(n),factor(n*n),rhs(n),step(n);
