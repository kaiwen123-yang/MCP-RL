+      // as far as its first blocking bound, then add that bound to the face.
+      u[i]=std::clamp(r.center[i]+delta[i]+alpha*direction[i],r.lower[i],r.upper[i]);
+      if(i==blocker) u[i]=direction[i]>0?r.upper[i]:r.lower[i];
+      if(u[i]==r.lower[i]) active[i]=-1;
+      else if(u[i]==r.upper[i]) active[i]=1;
+      moved=moved || u[i]!=previous;
+    }
+    if(!moved && blocker<0) {r.refinement_status="stationary_precision_limit";return false;}
+  }
+  r.refinement_status="iteration_limit";
+  return false;
+}
