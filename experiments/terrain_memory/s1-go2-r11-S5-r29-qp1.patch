+  // merely because one iterate has small residuals. Retain the full SPD metric
+  // requirement, including when the first refinement iterate already passes.
+  std::copy_n(H,n*n,factor.begin());
+  if(mju_cholFactor(factor.data(),n,0.0)<n ||
+      !std::all_of(factor.begin(),factor.end(),[](double x){return std::isfinite(x);})) {
+    r.refinement_status="metric_not_spd";return false;
+  }
+  for(int i=0;i<n;++i) {
+    u[i]=std::clamp(u[i],r.lower[i],r.upper[i]);
+    active[i]=r.fixed[i]?2:(u[i]==r.lower[i]?-1:(u[i]==r.upper[i]?1:0));
+  }
+  // A finite numerical guard, not a physical/admission limit. On exhaustion
+  // the original technical-failure path remains in force.
+  const int max_iterations=4*n*n+32;
+  for(int iteration=0;iteration<=max_iterations;++iteration) {
+    r.refinement_iterations=iteration;
+    double primal=0,kkt=0,free_gradient=0;
+    bool finite=true;
+    for(int i=0;i<n;++i) {
+      delta[i]=u[i]-r.center[i];
+      primal=std::max(primal,std::max(r.lower[i]-u[i],u[i]-r.upper[i]));
+    }
+    free.clear();
+    for(int i=0;i<n;++i) {
+      gradient[i]=0;
+      for(int j=0;j<n;++j) gradient[i]+=H[i*n+j]*delta[j];
+      finite=finite && std::isfinite(u[i]) && std::isfinite(gradient[i]);
+      const int certificate_active=r.fixed[i]?2:
+        (u[i]<=r.lower[i]+active_tol?-1:(u[i]>=r.upper[i]-active_tol?1:0));
+      const double residual=r.fixed[i]?0:(certificate_active==-1?std::max(0.,-gradient[i]):
+        (certificate_active==1?std::max(0.,gradient[i]):std::abs(gradient[i])));
+      kkt=std::max(kkt,residual);
+      if(!active[i]) {free.push_back(i);free_gradient=std::max(free_gradient,std::abs(gradient[i]));}
+    }
+    if(!finite) {r.refinement_status="non_finite_iterate";return false;}
+    if(primal<=primal_tol && kkt/scale<=relative_tol) {
+      r.nfree=free.size();r.refinement_status="converged";return true;
+    }
+    if(iteration==max_iterations) break;
+
+    // First minimize on the current feasible face. Only at a free-stationary
+    // point release a bound whose multiplier has the wrong sign.
+    if(free.empty() || free_gradient<=gradient_tol) {
+      int release=-1;double worst=gradient_tol;
+      for(int i=0;i<n;++i) {
+        const double wrong=active[i]==-1?-gradient[i]:(active[i]==1?gradient[i]:0.);
+        if(wrong>worst) {worst=wrong;release=i;}
+      }
+      if(release<0) {r.refinement_status="stationary_precision_limit";return false;}
+      active[release]=0;
+      continue;
+    }
+
+    const int nf=free.size();
+    for(int a=0;a<nf;++a) {
+      rhs[a]=-gradient[free[a]];
+      for(int b=0;b<nf;++b) factor[a*nf+b]=H[free[a]*n+free[b]];
+    }
+    if(mju_cholFactor(factor.data(),nf,0.0)<nf) {
+      r.refinement_status="free_metric_not_spd";return false;
+    }
+    mju_cholSolve(step.data(),factor.data(),rhs.data(),nf);
+    std::fill(direction.begin(),direction.end(),0.);
+    double alpha=1.;int blocker=-1;
+    for(int a=0;a<nf;++a) {
+      const int i=free[a];direction[i]=step[a];
+      if(!std::isfinite(direction[i])) {r.refinement_status="non_finite_direction";return false;}
+      const double bound_step=direction[i]>0?(r.upper[i]-u[i])/direction[i]:
+        (direction[i]<0?(r.lower[i]-u[i])/direction[i]:2.);
+      if(bound_step<=alpha) {alpha=std::max(0.,bound_step);blocker=i;}
+    }
+    bool moved=false;
+    for(int i:free) {
