+// Written before worker scheduling; immutable until every worker joins.
+struct R35Reference {
+  bool enabled=false;
+  int horizon=0,nu=0;
+  double origin=0,dt=.002;
+  unsigned long epoch=0,source_policy=0;
+  std::string branch="none",content_id="none";
+  std::vector<double> u,force,R;
+  int Node(double t) const {return int(std::llround((t-origin)/dt));}
+  double Residual(double t,int a,double held_u) const {
+    int k=Node(t);
+    if(!enabled || k<0 || k>=horizon-1)return 0.;
+    int i=k*nu+a;return std::sqrt(R[i])*(held_u-u[i]);
+  }
+  void Identify() {
+    uint64_t h=14695981039346656037ull;
+    auto bytes=[&](const void* p,size_t n){const auto* b=static_cast<const unsigned char*>(p);
+      for(size_t i=0;i<n;++i){h^=b[i];h*=1099511628211ull;}};
+    bytes(&origin,sizeof(origin));bytes(&dt,sizeof(dt));bytes(&source_policy,sizeof(source_policy));
+    for(const auto* v:{&u,&force,&R})bytes(v->data(),v->size()*sizeof(double));
+    bytes(branch.data(),branch.size());content_id=std::to_string(h);
+  }
+};
+inline R35Reference r35_reference;
+}
+#endif
