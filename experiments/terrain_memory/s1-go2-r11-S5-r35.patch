+// Shared actual-input anchor per physical/reference epoch, never per candidate.
+void iLQGPlanner::R35Freeze(int horizon,ThreadPool& pool) {
+  auto& ref=r35_reference;
+  const char* branch=std::getenv("MJPC_R35_BRANCH");
+  const std::string selected=branch?branch:"none";
+  if(selected!="none" && selected!="constant" && selected!="load")mju_error("r35 unknown branch");
+  if(r35_epoch==r32.epoch && ref.branch==selected)return;
+  r35_epoch=r32.epoch;ref=R35Reference{};ref.branch=selected;
+  ref.epoch=r32.epoch;ref.origin=time;ref.horizon=horizon;ref.nu=dim_action;
+  ref.dt=model->opt.timestep*GetNumberOrDefault(1,model,"s1_control_hold_substeps");
+  ref.source_policy=policy.record_plan_id;
+  ref.u.assign((horizon-1)*dim_action,0.);ref.R=ref.u;ref.force.assign(horizon*4,0.);
+  const auto* q=dynamic_cast<const QuadrupedFlat*>(task);
+  const bool moving=q && q->R35Moving();
+  if(const char* file=std::getenv("MJPC_R35_REFERENCE")) {
+    std::ifstream in(file,std::ios::binary);double h[8];in.read(reinterpret_cast<char*>(h),sizeof(h));
+    if(int(h[3])!=horizon || int(h[4])!=dim_action || h[2]!=time)mju_error("r35 offline reference context mismatch");
+    ref.source_policy=h[5];ref.enabled=h[6];ref.dt=h[7];
+    for(auto* v:{&ref.u,&ref.force,&ref.R})in.read(reinterpret_cast<char*>(v->data()),v->size()*sizeof(double));
+    if(!in)mju_error("r35 offline reference truncated");
+  } else if(moving) {
+    ResizeMjData(model,pool.NumThreads());
+    int failed_count=0;
+    auto f=[&](double* u,const double* x,double t){bool changed,failed,restored;
+      policy.ActionImpl(u,x,t,false,&changed,&failed,&restored);failed_count+=failed;};
+    trajectory[0].Rollout(f,task,model,data_[0].get(),state.data(),time,mocap.data(),userdata.data(),horizon);
+    ++r33_rollouts;
+    if(failed_count || trajectory[0].failure)mju_error("r35 input incumbent rollout failed");
+    ref.u.assign(trajectory[0].actions.begin(),trajectory[0].actions.begin()+(horizon-1)*dim_action);
+    for(int k=0;k<horizon;++k) {
+      double total=0;
+      for(int j=0;j<4;++j) {
+        const int i=k*29+1+7*j;
+        ref.force[4*k+j]=std::max(0.,trajectory[0].r33_foot_rows[i+4]+trajectory[0].r33_foot_rows[i+5]);
+        total+=ref.force[4*k+j];
+      }
+      if(k==horizon-1)continue;
+      double r[4],mean=0;
+      for(int j=0;j<4;++j){r[j]=.1152*(1.-(total>0?ref.force[4*k+j]/total:0.));mean+=r[j]/4.;}
+      for(int a=0;a<dim_action;++a) {
+        const char* name=mj_id2name(model,mjOBJ_ACTUATOR,a);
+        int leg=std::string(name).rfind("FL",0)==0?0:std::string(name).rfind("FR",0)==0?1:
+          std::string(name).rfind("RL",0)==0?2:std::string(name).rfind("RR",0)==0?3:-1;
+        if(leg<0)mju_error("r35 actuator name has no declared foot mapping");
+        ref.R[k*dim_action+a]=selected=="constant"?mean:(selected=="load"?r[leg]:0.);
+      }
+    }
+    ref.enabled=selected!="none";
+  }
+  ref.Identify();
+  if(const char* path=std::getenv("MJPC_R29_SNAPSHOT")) {
+    std::string name=std::string(path)+".r35-reference-"+std::to_string(r32.epoch)+".bin";
+    std::ofstream out(name,std::ios::binary);
+    double h[]={35.,double(ref.epoch),ref.origin,double(horizon),double(dim_action),double(ref.source_policy),double(ref.enabled),ref.dt};
+    out.write(reinterpret_cast<char*>(h),sizeof(h));
+    for(const auto* v:{&ref.u,&ref.force,&ref.R})out.write(reinterpret_cast<const char*>(v->data()),v->size()*sizeof(double));
+  }
+}
+void iLQGPlanner::R35DerivativeEvidence(int horizon,const char* role) {
+  int id=mj_name2id(model,mjOBJ_SENSOR,"InputReference");if(id<0)return;
+  int offset=model->sensor_adr[id];double cmax=0,dmax=0;
+  for(int k=0;k<horizon;++k)for(int a=0;a<dim_action;++a) {
+    double expected=r35_reference.enabled && k<horizon-1?std::sqrt(r35_reference.R[k*dim_action+a]):0.;
+    for(int x=0;x<dim_state_derivative;++x)cmax=std::max(cmax,std::abs(model_derivative.C[k*dim_sensor*dim_state_derivative+(offset+a)*dim_state_derivative+x]));
+    for(int b=0;b<dim_action;++b)dmax=std::max(dmax,std::abs(model_derivative.D[k*dim_sensor*dim_action+(offset+a)*dim_action+b]-(a==b?expected:0.)));
+  }
+  if(const char* path=std::getenv("MJPC_R29_SNAPSHOT")) {
+    std::ofstream out(std::string(path)+".r35-derivatives.jsonl",std::ios::app);out.precision(17);
+    out<<"{\"call\":"<<r29_call_id<<",\"epoch\":"<<r32.epoch<<",\"role\":\""<<role
+       <<"\",\"held_u_residual_D_max_error\":"<<dmax<<",\"direct_state_C_max_error\":"<<cmax<<"}\n";
+  }
+}
