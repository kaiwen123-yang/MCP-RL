+// One immutable packet per real replan, shared by every rollout and FD worker.
+#ifndef MJPC_R26_REFERENCE_H_
+#define MJPC_R26_REFERENCE_H_
+#include <mujoco/mujoco.h>
+#include "mjpc/utilities.h"
+namespace mjpc {
+inline void R26HeadReference(const mjModel* m,const mjData* d,double* target) {
+  const double* settings=GetCustomNumericData(m,"r26_reference");
+  if (!settings) return;
+  const double* p=d->userdata+84;
+  if (p[0]!=1.) return;
+  const double tau=mju_clip(d->time-p[1],0.,settings[0]);
+  const double lead=mju_max(0.,settings[1]/settings[2]-settings[0]);
+  const double dv=p[6]-p[5],a=settings[3];
+  const double b=mju_min(tau,mju_abs(dv)/a);
+  const double sign=dv>0 ? 1. : dv<0 ? -1. : 0.;
+  const double integral=p[5]*b+.5*sign*a*b*b+p[6]*(tau-b);
+  target[0]=p[2]+p[4]*mju_min(mju_abs(p[3]-p[2]),p[5]*lead+integral)+p[8];
+  target[1]=p[10]+p[9];target[2]=p[11];
+}
+}  // namespace mjpc
+#endif
