+// W37: shared pre-integration q/v risk values and active-branch geometry FD.
+#ifndef MJPC_R26_RISK_H_
+#define MJPC_R26_RISK_H_
+#include <vector>
+#include <mujoco/mujoco.h>
+#include "mjpc/utilities.h"
+#include "mjpc/tasks/quadruped/r10_contact.h"
+namespace mjpc {
+inline double R26DomainValue(const mjModel* m,const mjData* d,int geom) {
+  if (!R10MaterialFoot(m,d,geom)) return 0;
+  const double* margin=GetCustomNumericData(m,"r11_domain_margin");
+  const double floor=GetCustomNumericData(m,"s1_flat_ground_height")[0];
+  const double over=floor+m->geom_size[3*geom]-d->geom_xpos[3*geom+2]-margin[0];
+  return .5*(over+mju_sqrt(over*over+1e-12))/margin[1];
+}
+inline double R26ClearanceValue(const mjModel* m,const mjData* d,int geom) {
+  const int floor=mj_name2id(m,mjOBJ_GEOM,"floor");
+  const double margin=mju_max(m->geom_margin[floor],m->geom_margin[geom]);
+  const double over=margin-mj_geomDistance(m,d,floor,geom,1.,nullptr);
+  return .5*(over+mju_sqrt(over*over+1e-12))/
+      GetCustomNumericData(m,"r12_trunk_clearance")[0];
+}
+inline double R26ImpactValue(const mjModel* m,const mjData* d,int geom) {
+  const double* p=d->geom_xpos+3*geom;
+  constexpr double half=.015811388300841896;
+  const double band=GetNumberOrDefault(0.,m,"r11_landing_approach_band");
+  if (p[0]<.8+half-band || p[0]>2.2-half+band || mju_abs(p[1])>.6-half+band) return 0;
+  const double* margin=GetCustomNumericData(m,"r26_impact_margin");
+  const double z=p[2]-m->geom_size[3*geom]-GetCustomNumericData(m,"s1_flat_ground_height")[0];
+  double velocity[6];mj_objectVelocity(m,d,mjOBJ_GEOM,geom,velocity,0);
+  const double down=mju_max(-velocity[5],0.);
+  const double hold=m->opt.timestep*GetNumberOrDefault(1,m,"s1_control_hold_substeps");
+  const double over=hold*down+down*down/(2*mju_abs(m->opt.gravity[2]))-(z+margin[0]);
+  return .5*(over+mju_sqrt(over*over+1e-12))/margin[1];
+}
+struct R26RiskRow { int sensor,geom,kind; };
+inline std::vector<R26RiskRow> R26RiskRows(const mjModel* m) {
+  std::vector<R26RiskRow> rows;
+  if (!GetCustomNumericData(m,"r12_substep_path")) return rows;
+  const char* names[]={"MaterialDomainMargin","TrunkClearance","ImpactMargin"};
+  for (int kind=0;kind<3;++kind) {
+    const int sensor=mj_name2id(m,mjOBJ_SENSOR,names[kind]);
+    int adr=m->sensor_adr[sensor];
+    if (kind==1) {
+      const int trunk=mj_name2id(m,mjOBJ_BODY,"trunk"),floor=mj_name2id(m,mjOBJ_GEOM,"floor");
+      for (int geom=0;geom<m->ngeom;++geom)
+        if (m->geom_bodyid[geom]==trunk &&
+            ((m->geom_contype[geom]&m->geom_conaffinity[floor]) ||
+             (m->geom_contype[floor]&m->geom_conaffinity[geom])))
+          rows.push_back({adr++,geom,kind});
+    } else {
+      // Same enum/sensor order as QuadrupedFlat: FL, HL, FR, HR.
+      for (const char* foot:{"FL","RL","FR","RR"})
+        rows.push_back({adr++,mj_name2id(m,mjOBJ_GEOM,foot),kind});
+    }
+  }
+  return rows;
+}
+inline double R26RiskValue(const mjModel* m,const mjData* d,const R26RiskRow& row) {
+  return row.kind==0 ? R26DomainValue(m,d,row.geom) :
+         row.kind==1 ? R26ClearanceValue(m,d,row.geom) : R26ImpactValue(m,d,row.geom);
+}
+inline void R26RiskKinematics(const mjModel* m,mjData* d) {
+  mj_kinematics(m,d);mj_comPos(m,d);mj_comVel(m,d);
+}
+inline void R26AccumulatePath(double* peak,const double* pre_step_sensor,
+                              const std::vector<R26RiskRow>& rows) {
+  for (const auto& row:rows)
+    if (pre_step_sensor[row.sensor]>peak[row.sensor])
+      peak[row.sensor]=pre_step_sensor[row.sensor];
+}
+// Differentiate only rows whose final active state is this substep. No contact
+// solver or sensor callbacks; all three risks have zero direct control term.
+inline void R26RiskJacobian(const mjModel* m,mjData* d,double eps,int centered,
+    const std::vector<R26RiskRow>& rows,const std::vector<int>& selected,
+    int nx,double* jac) {
+  const int nr=selected.size();
+  std::vector<double> q(d->qpos,d->qpos+m->nq),v(d->qvel,d->qvel+m->nv);
+  std::vector<double> delta(m->nv,0.),base(nr),plus(nr),minus(nr);
+  R26RiskKinematics(m,d);mju_zero(jac,nr*nx);
+  for (int r=0;r<nr;++r)base[r]=R26RiskValue(m,d,rows[selected[r]]);
+  for (int k=0;k<2*m->nv;++k) {
+    const int index=k%m->nv;
+    for (int sign=1;sign>=-1;sign-=2) {
+      if (sign<0 && !centered)break;
+      mju_copy(d->qpos,q.data(),m->nq);mju_copy(d->qvel,v.data(),m->nv);
+      if (k<m->nv) {
+        delta[index]=sign*eps;mj_integratePos(m,d->qpos,delta.data(),1.);delta[index]=0.;
+      } else d->qvel[index]+=sign*eps;
+      R26RiskKinematics(m,d);
+      auto& value=sign>0 ? plus : minus;
+      for (int r=0;r<nr;++r)value[r]=R26RiskValue(m,d,rows[selected[r]]);
+    }
+    for (int r=0;r<nr;++r)
+      jac[r*nx+k]=(plus[r]-(centered ? minus[r] : base[r]))/((centered ? 2 : 1)*eps);
+  }
+  mju_copy(d->qpos,q.data(),m->nq);mju_copy(d->qvel,v.data(),m->nv);
+  R26RiskKinematics(m,d);
+}
+}  // namespace mjpc
+#endif
