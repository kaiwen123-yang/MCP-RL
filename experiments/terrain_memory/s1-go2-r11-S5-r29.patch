+// W40: legacy target-clipped policy projected in its successful backward H.
+// Pure evaluation: no global scratch, warm start, RNG, or controller mutation.
+#ifndef MJPC_R29_PROJECTION_H_
+#define MJPC_R29_PROJECTION_H_
+#include <algorithm>
+#include <cmath>
+#include <vector>
+#include <mujoco/mujoco.h>
+#include "mjpc/planners/ilqg/boxqp.h"
+namespace mjpc {
+struct R29Projection {
+  std::vector<double> center, lower, upper, delta, pd, violation, gradient;
+  std::vector<int> fixed, empty, active, lower_source, upper_source;
+  double primal=0, kkt=0, kkt_scaled=0, max_delta=0;
+  bool changed=false, restoration=false, converged=true;
+  int nfree=-2;
+  const char* status="legacy_seed_no_metric";
+};
+inline R29Projection R29Project(const mjModel* m, const double* state,
+                                const double* H, bool valid, double* u) {
+  const int n=m->nu;
+  R29Projection r;
+  r.center.assign(u,u+n);r.lower.resize(n);r.upper.resize(n);
+  r.delta.resize(n);r.pd.resize(n);r.violation.resize(n);
+  r.fixed.resize(n);r.empty.resize(n);r.active.resize(n);
+  r.lower_source.resize(n);r.upper_source.resize(n);r.gradient.resize(n);
+  if(!state || !valid) {r.status=state?"legacy_seed_no_metric":"nominal_null_state";return r;}
+  std::vector<int> free;
+  bool inside=true;
+  for(int i=0;i<n;++i) {
+    int joint=m->actuator_trnid[2*i],q=m->jnt_qposadr[joint],v=m->jnt_dofadr[joint];
+    double lo=m->actuator_ctrlrange[2*i],hi=m->actuator_ctrlrange[2*i+1];
+    double qv=state[q],vel=state[m->nq+v];
+    double pl=qv+(m->actuator_forcerange[2*i]+5*vel)/60;
+    double ph=qv+(m->actuator_forcerange[2*i+1]+5*vel)/60;
+    r.lower[i]=std::max(lo,pl);r.upper[i]=std::min(hi,ph);
+    r.lower_source[i]=(pl>lo?1:(pl==lo?2:0));
+    r.upper_source[i]=(ph<hi?1:(ph==hi?2:0));
+    if(r.lower[i]>r.upper[i]) {
+      r.empty[i]=1;r.restoration=true;
+      r.lower[i]=r.upper[i]=(pl>hi?hi:lo);
+    }
+    r.fixed[i]=(r.lower[i]==r.upper[i]);
+    if(r.fixed[i]) u[i]=r.lower[i]; else free.push_back(i);
+    inside=inside && r.center[i]>=r.lower[i] && r.center[i]<=r.upper[i];
+  }
+  if(!inside && !free.empty()) {
+    int nf=free.size();BoxQP qp;qp.Allocate(nf);
+    for(int a=0;a<nf;++a) {
+      int i=free[a];qp.lower[a]=r.lower[i];qp.upper[a]=r.upper[i];
+      qp.res[a]=std::clamp(r.center[i],r.lower[i],r.upper[i]);
+      for(int j=0;j<n;++j) {
+        qp.g[a]-=H[i*n+j]*r.center[j];
+        if(r.fixed[j]) qp.g[a]+=H[i*n+j]*u[j];
+      }
+      for(int b=0;b<nf;++b) qp.H[a*nf+b]=H[i*n+free[b]];
+    }
+    r.nfree=mju_boxQP(qp.res.data(),qp.R.data(),qp.index.data(),
+                     qp.H.data(),qp.g.data(),nf,qp.lower.data(),qp.upper.data());
+    for(int a=0;a<nf;++a) u[free[a]]=qp.res[a];
+  }
+  for(int i=0;i<n;++i) {
+    r.delta[i]=u[i]-r.center[i];
+    r.max_delta=std::max(r.max_delta,std::abs(r.delta[i]));
+    r.primal=std::max(r.primal,std::max(r.lower[i]-u[i],u[i]-r.upper[i]));
+  }
+  double scale=1;
+  for(int i=0;i<n;++i) {
+    double hc=0;
+    for(int j=0;j<n;++j) {r.gradient[i]+=H[i*n+j]*r.delta[j];hc+=std::abs(H[i*n+j]*r.center[j]);}
+    scale=std::max(scale,hc);
+    r.active[i]=r.fixed[i]?2:(u[i]<=r.lower[i]+1e-12?-1:(u[i]>=r.upper[i]-1e-12?1:0));
+    double res=r.fixed[i]?0:(r.active[i]==-1?std::max(0.,-r.gradient[i]):
+      (r.active[i]==1?std::max(0.,r.gradient[i]):std::abs(r.gradient[i])));
+    r.kkt=std::max(r.kkt,res);
+    int joint=m->actuator_trnid[2*i];
+    r.pd[i]=60*(u[i]-state[m->jnt_qposadr[joint]])-5*state[m->nq+m->jnt_dofadr[joint]];
+    r.violation[i]=std::max({0.,m->actuator_forcerange[2*i]-r.pd[i],r.pd[i]-m->actuator_forcerange[2*i+1]});
+    if(!std::isfinite(u[i]) || !std::isfinite(r.gradient[i])) r.converged=false;
+  }
+  r.kkt_scaled=r.kkt/scale;
+  r.converged=r.converged && r.nfree!=-1 && r.primal<=1e-10 && r.kkt_scaled<=1e-7;
+  r.changed=r.max_delta>0;
+  r.status=!r.converged?"qp_kkt_failure":(r.restoration?"minimum_PD_violation_restoration":
+      (inside?"legacy_center_feasible":"metric_projection"));
+  return r;
+}
+}
