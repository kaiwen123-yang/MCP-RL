+// Flattened variable-contact rows, sampled from the actual candidate rollout.
+void Trajectory::R29RecordedStep(const mjModel* m,mjData* d,int node,int substep) {
+  if(node>=10) {mj_step(m,d);return;}
+  const size_t start=r29_prefix.size();
+  auto append=[&](const double* x,int n){r29_prefix.insert(r29_prefix.end(),x,x+n);};
+  r29_prefix.insert(r29_prefix.end(),{double(node),double(substep),d->time,0.,0.});
+  append(d->qpos,m->nq);append(d->qvel,m->nv);append(d->act,m->na);
+  std::vector<double> pd(m->nu);
+  for(int i=0;i<m->nu;++i) {
+    int j=m->actuator_trnid[2*i];
+    pd[i]=60*(d->ctrl[i]-d->qpos[m->jnt_qposadr[j]])-5*d->qvel[m->jnt_dofadr[j]];
+  }
+  mj_step(m,d);
+  r29_prefix[start+3]=d->time;r29_prefix[start+4]=d->ncon;
+  append(d->qpos,m->nq);append(d->qvel,m->nv);append(d->act,m->na);
+  append(pd.data(),m->nu);append(d->actuator_force,m->nu);
+  append(d->qfrc_passive,m->nv);append(d->sensordata,dim_residual);
+  for(int c=0;c<d->ncon;++c) {
+    r29_prefix.push_back(d->contact[c].geom[0]);r29_prefix.push_back(d->contact[c].geom[1]);
+    double force[6];mj_contactForce(m,d,c,force);append(force,6);
+  }
 }
 
