+  std::vector<double> J(3*nv),Jr(3*nv),sol(nv);
+  for(int j=0;j<nu;j++){
+    const int joint=m->actuator_trnid[2*j];
+    q[j]=d->qpos[m->jnt_qposadr[joint]];v[j]=d->qvel[m->jnt_dofadr[joint]];raw[j]=d->ctrl[j];
+  }
