+// W41 isolated GPU predictor bridge. CPU main artifacts do not include it.
+#ifndef MJPC_W41_GPU_H_
+#define MJPC_W41_GPU_H_
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <unistd.h>
+#include <cstdlib>
+#include <cstring>
+#include <cstdint>
+#include <stdexcept>
+#include <vector>
+#include <mujoco/mujoco.h>
+namespace mjpc {
+inline const char* W41GPUPath(){return std::getenv("MJPC_W41_GPU_SOCKET");}
+inline void W41Transfer(int fd,void* data,size_t size,bool send_data){
+  char* p=static_cast<char*>(data);
+  while(size){ssize_t n=send_data?send(fd,p,size,MSG_NOSIGNAL):recv(fd,p,size,0);
+    if(n<=0)throw std::runtime_error("W41 GPU transport failed; no predictor fallback");
+    p+=n;size-=n;}
+}
+inline std::vector<double> W41GPUHold(const mjModel* m,const mjData* d,bool fd_mode){
+  int fd=socket(AF_UNIX,SOCK_STREAM,0);sockaddr_un address{};address.sun_family=AF_UNIX;
+  std::strncpy(address.sun_path,W41GPUPath(),sizeof(address.sun_path)-1);
+  if(connect(fd,reinterpret_cast<sockaddr*>(&address),sizeof(address))<0){close(fd);throw std::runtime_error("W41 GPU unavailable");}
+  uint64_t header[8]={0x573431475055,static_cast<uint64_t>(fd_mode),
+    static_cast<uint64_t>(m->nq),static_cast<uint64_t>(m->nv),static_cast<uint64_t>(m->na),
+    static_cast<uint64_t>(m->nu),static_cast<uint64_t>(m->nuserdata),static_cast<uint64_t>(m->nmocap)};
+  std::vector<double> input{d->time};
+  auto add=[&](const double* p,int n){input.insert(input.end(),p,p+n);};
+  add(d->qpos,m->nq);add(d->qvel,m->nv);add(d->act,m->na);add(d->ctrl,m->nu);
+  add(d->mocap_pos,3*m->nmocap);add(d->mocap_quat,4*m->nmocap);add(d->userdata,m->nuserdata);
+  W41Transfer(fd,header,sizeof(header),true);W41Transfer(fd,input.data(),input.size()*8,true);
+  uint64_t count=0;W41Transfer(fd,&count,8,false);
+  const uint64_t expected=10*(m->nq+m->nv+m->na)+(fd_mode?10*(2*m->nv+m->na)*(2*m->nv+m->na+m->nu):0);
+  if(count!=expected){close(fd);throw std::runtime_error("W41 GPU response/error, see first failure input");}
+  std::vector<double> result(count);W41Transfer(fd,result.data(),count*8,false);close(fd);return result;
+}
+inline void W41GPURecordedStep(const mjModel* m,mjData* d,int substep){
+  if(!W41GPUPath()){mj_step(m,d);return;}
+  static thread_local std::vector<double> held;
+  if(substep==0)held=W41GPUHold(m,d,false);
+  // Original task residual/private phase evaluates the GPU pre-integration
+  // state on CPU. Sensor/contact evidence here is native cost evaluation;
+  // GPU contact/solver evidence is retained by the separate service.
+  mj_forward(m,d);
+  const int ns=m->nq+m->nv+m->na;const double* x=held.data()+substep*ns;
+  mju_copy(d->qpos,x,m->nq);mju_copy(d->qvel,x+m->nq,m->nv);
+  mju_copy(d->act,x+m->nq+m->nv,m->na);d->time+=m->opt.timestep;
+}
+}
+#endif
