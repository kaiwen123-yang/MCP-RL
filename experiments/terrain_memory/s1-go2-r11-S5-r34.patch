+int iLQGPlanner::BestRollout(int preferred, bool action_search) {
+  int best=-1;
+  auto consider=[&](int j) {
+    if(j<0 || (action_search && linesearch_steps[j]<=0) || trajectory[j].failure ||
+       !std::isfinite(trajectory[j].total_return) || !std::isfinite(trajectory[j].trunk_violation))return;
+    if(best<0 || R34Better(trajectory[j],trajectory[best]))best=j;
+  };
+  if(r34_enabled) {
+    consider(preferred);
+    // Match archive traversal exactly; numerical ties retain the incumbent.
+    for(int j=0;j<num_trajectory_;++j)if(j!=preferred)consider(j);
+  } else for(int j=num_trajectory_-1;j>=0;--j)consider(j);
+  return best;
 }
 
