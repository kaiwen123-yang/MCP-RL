+// FP64 budget for the existing sequential norm/term/time summations.
+// The smooth-norm subtraction envelope is retained even when J is tiny.
+// This is cost arithmetic resolution, never a tolerance on trunk violation.
+double iLQGPlanner::R34Budget(const Trajectory& tr) const {
+  const double unit=std::numeric_limits<double>::epsilon()/2.;
+  const double n=tr.horizon*(8.*task->num_residual+4.*task->num_term+2.)+1.;
+  const double gamma=n*unit/(1.-n*unit);
+  double magnitude=0,terms[kMaxCostTerms];
+  for(int t=0;t<tr.horizon;++t) {
+    task->CostTerms(terms,tr.residual.data()+t*task->num_residual);
+    for(int k=0;k<task->num_term;++k)magnitude+=std::abs(terms[k])/tr.horizon;
+  }
+  int offset=0;
+  for(int k=0;k<task->num_term;++k) {
+    if(task->norm[k]==2 || task->norm[k]==6)
+      magnitude+=2.*std::abs(task->weight[k]*task->norm_parameter[offset])*
+        (task->norm[k]==6?task->dim_norm_residual[k]:1);
+    offset+=task->num_norm_parameter[k];
+  }
+  return gamma*magnitude;
+}
+bool iLQGPlanner::R34Better(const Trajectory& a,const Trajectory& b) const {
+  if(a.failure || !std::isfinite(a.total_return) || !std::isfinite(a.trunk_violation))return false;
+  if(b.failure || !std::isfinite(b.total_return) || !std::isfinite(b.trunk_violation))return true;
+  return a.trunk_violation<b.trunk_violation ||
+    (a.trunk_violation==b.trunk_violation &&
+     b.total_return-a.total_return>(r34_enabled?R34Budget(a)+R34Budget(b):0.));
+}
+// Offline only: score the imported complete policy, with no optimization.
+// Repeated calls re-import the requested file into the same native process.
+void iLQGPlanner::R34ScoreOnly(int horizon,ThreadPool& pool) {
+  ResizeMjData(model,pool.NumThreads());
+  auto action=[&](double* u,const double* x,double t) {
+    bool changed,failed,restored;
+    policy.ActionImpl(u,x,t,false,&changed,&failed,&restored);
+    r29_failed[0]+=failed;
+  };
+  r29_failed[0]=0;
+  trajectory[0].Rollout(action,task,model,data_[0].get(),state.data(),time,mocap.data(),userdata.data(),horizon);
+  if(r29_failed[0])trajectory[0].failure=true;
+  R33Consider(policy,trajectory[0],horizon,3,0,policy.action_step_alpha,"offline_score_only");
+  r32.deployable=r33_archive_valid;
+  if(r33_archive_valid)R33WriteSnapshot(horizon);
+}
