+
+// Recover the original geometric margin-gap from its existing monotone
+// smooth positive-part residual. r*scale = (over + sqrt(over^2+1e-12))/2,
+// hence over = r*scale - 1e-12/(4*r*scale). The boundary is exactly r*scale=5e-7.
+// No new geometry, clearance margin, penalty weight or dynamics is introduced.
+void Trajectory::UpdateTrunkViolation(const mjModel* model) {
+  trunk_violation = 0.0;
+  if (!GetCustomNumericData(model, "r12_substep_path")) return;
+  const int sensor = mj_name2id(model, mjOBJ_SENSOR, "TrunkClearance");
+  const double scale = GetCustomNumericData(model, "r12_trunk_clearance")[0];
+  const int adr = model->sensor_adr[sensor], size = model->sensor_dim[sensor];
+  for (int t = 0; t < horizon; ++t) {
+    for (int j = 0; j < size; ++j) {
+      const double positive = residual[t * dim_residual + adr + j] * scale;
+      if (positive > 5e-7)
+        trunk_violation = mju_max(trunk_violation,
+                                 positive - 1e-12 / (4 * positive));
+    }
+  }
 }
 
