+      if(!f.ready || f.segment!=id) {
+        f.ready=true;f.segment=id;f.swing=sw;f.begin=d->time;f.end=end;
+        for(int j=0;j<3;++j)f.anchor[j]=d->geom_xpos[3*geoms[i]+j];
+        if(sw)f.touchdown=Touchdown(m,d,i,end);
+      }
+    }
+  }
+};
+} // namespace mjpc
