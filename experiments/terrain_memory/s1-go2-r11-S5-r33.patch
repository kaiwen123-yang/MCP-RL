+// Read the existing native solve at the rollout node. MuJoCo's geom/contact
+// arrays after mj_step belong to the pre-integration state, just as residuals.
+void Trajectory::R33RecordFeet(const mjModel* m,const mjData* d,double state_time) {
+  r33_foot_rows.push_back(state_time);
+  const double* material=GetCustomNumericData(m,"r10_local_contact");
+  const double floor=GetNumberOrDefault(0,m,"s1_flat_ground_height");
+  for(const char* name : {"FL","FR","RL","RR"}) {
+    const int geom=mj_name2id(m,mjOBJ_GEOM,name);
+    const double* xyz=d->geom_xpos+3*geom;
+    const double bottom=xyz[2]-m->geom_size[3*geom];
+    double native_fz=0;
+    int contacts=0;
+    for(int c=0;c<d->ncon;++c) {
+      const auto& contact=d->contact[c];
+      const bool first=contact.geom[0]==geom && m->geom_bodyid[contact.geom[1]]==0;
+      const bool second=contact.geom[1]==geom && m->geom_bodyid[contact.geom[0]]==0;
+      if(first || second) {
+        double wrench[6],world[3];
+        mj_contactForce(m,d,c,wrench);
+        mju_mulMatTVec(world,contact.frame,wrench,3,3);
+        native_fz+=(second ? 1 : -1)*world[2];
+        ++contacts;
+      }
+    }
+    double material_fz=0;
+    if(material && R10MaterialFoot(m,d,geom)) {
+      const double point[3]={xyz[0],xyz[1],bottom};
+      material_fz=material[0]*mju_max(floor+R10ContactRest(m,d,point)-bottom,0);
+    }
+    r33_foot_rows.insert(r33_foot_rows.end(),{
+        xyz[0],xyz[1],xyz[2],bottom,native_fz,material_fz,double(contacts)});
   }
