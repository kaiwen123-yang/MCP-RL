+// One P32 batch: two cached baseline identities and 15 signed pairs.
+void iLQGPlanner::R33Structured(int horizon,ThreadPool& pool) {
+  if(!r33_archive_valid) {R32ReuseIncumbent("no_scored_structured_base");return;}
+  const iLQGPolicy base=r33_nominal_policy;
+  const Trajectory base_tr=r33_nominal_trajectory;
+  r33_cache_hits+=2; // incumbent and best nominal were scored in the nominal stage.
+  const int previous_count=num_trajectory_;num_trajectory_=30;
+  for(int j=0;j<30;++j) {
+    auto& p=candidate_policy[j];p=base;
+    const int group=(j/2)/3, onset_index=(j/2)%3;
+    const double sign=(j%2==0?1.:-1.),onset=.08*onset_index,duration=.16;
+    for(int t=0;t<horizon;++t) {
+      const double z=(p.trajectory.times[t]-time-onset)/duration;
+      if(z<=0 || z>=1)continue;
+      for(int leg=0;leg<4;++leg) if(group==leg || (group==4 && (leg==0 || leg==3))) {
+        p.trajectory.actions[t*dim_action+3*leg]+=.04*sign*std::sin(2*3.141592653589793*z);
+        p.trajectory.actions[t*dim_action+3*leg+1]+=.04*sign*std::sin(3.141592653589793*z);
+        p.trajectory.actions[t*dim_action+3*leg+2]-=.08*sign*std::sin(3.141592653589793*z);
+      }
+    }
+  }
+  int before=pool.GetCount();
+  for(int j=0;j<30;++j)pool.Schedule([&,j](){
+    auto f=[&,j](double* u,const double* x,double t){
+      bool changed,failed,restored;candidate_policy[j].ActionImpl(u,x,t,false,&changed,&failed,&restored);
+      r29_projected[j]+=changed;r29_failed[j]+=failed;r29_restored[j]+=restored;
+    };
+    r29_projected[j]=r29_failed[j]=r29_restored[j]=0;
+    trajectory[j].Rollout(f,task,model,data_[ThreadPool::WorkerId()].get(),state.data(),time,
+                          mocap.data(),userdata.data(),horizon);
+    if(r29_failed[j])trajectory[j].failure=true;
+  });
+  pool.WaitCount(before+30);pool.ResetCount();r33_rollouts+=30;
+  for(int j=0;j<30;++j)R33Consider(candidate_policy[j],trajectory[j],horizon,2,j+2,
+                                 j%2==0?1.:-1.,"structured_"+std::to_string(j+2));
+  num_trajectory_=previous_count;
+}
