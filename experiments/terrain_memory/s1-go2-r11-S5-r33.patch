+void iLQGPlanner::R33WriteSnapshot(int horizon) {
+  // One binary transport snapshot per newly installed plan. Python retains
+  // the bounded event ring and compresses each selected plan once.
+  if(const char* file=std::getenv("MJPC_R29_SNAPSHOT")) {
+    std::ofstream out(file,std::ios::binary|std::ios::trunc);
+    double header[]={32.,double(policy.record_plan_id),time,double(horizon),
+      double(dim_state),double(dim_action),double(dim_state_derivative),
+      double(task->num_residual),policy.metric_regularization,double(policy.metric_regularization_type),
+      policy.nominal_feedback_scale,policy.action_step_alpha,policy.feedback_scaling,
+      double(policy.representation),double(model->nuserdata),r33_archive_trajectory.total_return};
+    out.write(reinterpret_cast<char*>(header),sizeof(header));
+    auto write=[&out](const std::vector<double>& v,int n) {
+      out.write(reinterpret_cast<const char*>(v.data()),n*sizeof(double));
+    };
+    for(const auto* tr:{&r33_archive_trajectory,&policy.trajectory}) {
+      write(tr->states,horizon*dim_state);write(tr->actions,(horizon-1)*dim_action);
+      write(tr->times,horizon);write(tr->residual,horizon*task->num_residual);
+    }
+    write(policy.feedback_gain,horizon*dim_action*dim_state_derivative);
+    write(policy.metric,horizon*dim_action*dim_action);
+    write(policy.base_Qu,horizon*dim_action);
+    write(policy.base_Qxu,horizon*dim_action*dim_state_derivative);
+    write(policy.base_active,horizon*dim_action);
+    write(userdata,model->nuserdata);
+    double count=r33_archive_trajectory.r29_prefix.size();
+    out.write(reinterpret_cast<char*>(&count),sizeof(double));
+    write(r33_archive_trajectory.r29_prefix,int(count));
+    for(const auto* v:{&model_derivative.r31_substeps,
+                       &model_derivative.r31_risk_peaks,
+                       &model_derivative.r31_first_AB}) {
+      double size=v->size();out.write(reinterpret_cast<char*>(&size),sizeof(double));
+      write(*v,int(size));
+    }
+    write(model_derivative.A,(horizon-1)*dim_state_derivative*dim_state_derivative);
+    write(model_derivative.B,(horizon-1)*dim_state_derivative*dim_action);
+  }
+}
