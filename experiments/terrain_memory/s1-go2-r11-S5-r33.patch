+void iLQGPlanner::R33Import(int horizon) {
+  if(r33_imported)return;
+  r33_imported=true;
+  const char* name=std::getenv("MJPC_R33_INPUT_POLICY");if(!name)return;
+  std::ifstream in(name,std::ios::binary);
+  double h[16];in.read(reinterpret_cast<char*>(h),sizeof(h));
+  if(!in || int(h[3])!=horizon || int(h[4])!=dim_state || int(h[5])!=dim_action ||
+     int(h[6])!=dim_state_derivative || int(h[7])!=task->num_residual)
+    mju_error("r33 saved policy dimensions/header mismatch");
+  auto read=[&](std::vector<double>& v,int n){in.read(reinterpret_cast<char*>(v.data()),n*sizeof(double));};
+  auto& tr=policy.trajectory;tr.horizon=horizon;
+  read(tr.states,horizon*dim_state);read(tr.actions,(horizon-1)*dim_action);
+  std::copy_n(tr.actions.data()+(horizon-2)*dim_action,dim_action,tr.actions.data()+(horizon-1)*dim_action);
+  read(tr.times,horizon);read(tr.residual,horizon*task->num_residual);
+  read(policy.feedback_gain,horizon*dim_action*dim_state_derivative);
+  read(policy.metric,horizon*dim_action*dim_action);read(policy.base_Qu,horizon*dim_action);
+  read(policy.base_Qxu,horizon*dim_action*dim_state_derivative);read(policy.base_active,horizon*dim_action);
+  if(!in)mju_error("r33 saved policy truncated");
+  policy.record_plan_id=h[1];policy.metric_valid=true;policy.metric_regularization=h[8];
+  policy.metric_regularization_type=h[9];policy.nominal_feedback_scale=h[10];
+  policy.action_step_alpha=h[11];policy.feedback_scaling=h[12];policy.representation=h[13];
+}
+
+void iLQGPlanner::R33Consider(const iLQGPolicy& p,const Trajectory& tr,int horizon,
+    int kind,int slot,double alpha,const std::string& source) {
+  ++r33_slots;
+  const bool valid=p.metric_valid && !tr.failure && std::isfinite(tr.total_return) &&
+                   std::isfinite(tr.trunk_violation);
+  if(valid && (!r33_archive_valid || tr.trunk_violation<r33_archive_trajectory.trunk_violation ||
+     (tr.trunk_violation==r33_archive_trajectory.trunk_violation &&
+      tr.total_return<r33_archive_trajectory.total_return))) {
+    r33_archive_policy=p;r33_archive_trajectory=tr;r33_archive_valid=true;r33_source=source;
+  }
+  if(const char* path=std::getenv("MJPC_R29_SNAPSHOT")) {
+    std::ofstream out(std::string(path)+".r33-candidates",std::ios::binary|std::ios::app);
+    double h[]={33.,double(r29_call_id),double(kind),double(slot),alpha,double(horizon),
+      double(dim_state),double(dim_action),double(dim_state_derivative),double(task->num_residual),
+      p.feedback_scaling,tr.total_return,tr.trunk_violation,double(tr.failure),double(p.metric_valid),
+      time,p.metric_regularization,double(p.representation),double(p.record_plan_id)};
+    out.write(reinterpret_cast<char*>(h),sizeof(h));
+    auto w=[&](const std::vector<double>& v,int n){out.write(reinterpret_cast<const char*>(v.data()),n*sizeof(double));};
+    for(const auto* t:{&tr,&p.trajectory}) {
+      w(t->states,horizon*dim_state);w(t->actions,(horizon-1)*dim_action);
+      w(t->times,horizon);w(t->residual,horizon*task->num_residual);
+    }
+    w(p.feedback_gain,horizon*dim_action*dim_state_derivative);w(p.metric,horizon*dim_action*dim_action);
+    w(p.base_Qu,horizon*dim_action);w(p.base_Qxu,horizon*dim_action*dim_state_derivative);
+    w(p.base_active,horizon*dim_action);
+    double n=tr.r29_prefix.size();out.write(reinterpret_cast<char*>(&n),sizeof(double));w(tr.r29_prefix,int(n));
+    n=tr.r33_foot_rows.size();out.write(reinterpret_cast<char*>(&n),sizeof(double));w(tr.r33_foot_rows,int(n));
+  }
+}
